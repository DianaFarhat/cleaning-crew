// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`


generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"


}

// =========================================================
// ENUMS
// =========================================================

enum UserRole {
  cleaner
  owner
  admin
}

enum CleanerStatus {
  active
  inactive
}

enum AssignmentStatus {
  assigned
  unassigned
}

enum CompletionStatus {
  upcoming
  in_progress
  completed
  cancelled
}

enum PaymentStatus {
  pending
  received
}

enum CleaningSessionTaskStatus {
  pending
  completed
  skipped
}

enum NotificationType {
  session_assigned
  session_cancelled
  session_updated
  session_started
  session_completed
  session_unassigned_alert
}

// =========================================================
// USERS & AVAILABILITY
// =========================================================

model User {
  userId            String          @id @default(uuid())
  username          String
  role              UserRole
  email             String          @unique
  emailVerified     Boolean         @default(false) @map("email_verified")
  emailVerifiedAt   DateTime?       @map("email_verified_at")
  passwordHash      String          @map("password_hash")
  passwordChangedAt DateTime?       @map("password_changed_at")
  phoneNumber       String          @map("phone_number") //TODO: This shouldn't be nullable
  profileImage      String?         @map("profile_image")
  cleanerStatus     CleanerStatus?  @map("cleaner_status")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  availabilitySlots          AvailabilitySlot[]
  chalets                    Chalet[]
  cleaningSessionTemplates   CleaningSessionTemplate[]
  ownedCleaningSessions      CleaningSession[] @relation("SessionOwner")
  cleanerCleaningSessions    CleaningSession[] @relation("SessionCleaner")
  cancelledCleaningSessions  CleaningSession[] @relation("SessionCancelledBy")
  notifications              Notification[]

  @@index([role, username], name: "idx_users_role_username")
}

model AvailabilitySlot {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  date      DateTime @db.Date
  startTime DateTime @db.Time @map("start_time")
  endTime   DateTime @db.Time @map("end_time")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cleaner User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, date, startTime, endTime])
  @@index([userId, date], map: "idx_availability_user_date")
}

// =========================================================
// CHALETS
// =========================================================

model Chalet {
  id                  Int      @id @default(autoincrement())
  ownerId             String   @map("owner_id")
  name                String
  location            String
  latitude            Decimal? @db.Decimal(10, 8)
  longitude           Decimal? @db.Decimal(11, 8)
  accessInstructions  String?  @map("access_instructions")
  permanentNotes      String?  @map("permanent_notes")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  owner             User              @relation(fields: [ownerId], references: [userId])
  chaletImages      ChaletImage[]
  cleaningSessions  CleaningSession[]

  @@index([ownerId, id], map: "idx_chalets_owner_id")
}

 
model ChaletImage {
  id           Int      @id @default(autoincrement())
  chaletId     Int      @map("chalet_id")
  storageKey   String   @map("storage_key")
  url          String?
  isCover      Boolean  @default(false) @map("is_cover")
  displayOrder Int?     @map("display_order")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  chalet Chalet @relation(fields: [chaletId], references: [id])

  @@index([chaletId], map: "idx_chalet_images_chalet_id")
}

// =========================================================
// CLEANING SESSION TEMPLATES
// Owner-scoped, reusable checklists. Every new owner gets their
// own copy of the platform's global templates at signup (app-level
// logic, not enforced here) — there is no shared/global row referenced
// at runtime, so owner_id is effectively always set post-signup.
// Soft-deleted via archived_at so past sessions that reference a
// template keep working after an owner "deletes" it.
// =========================================================

model CleaningSessionTemplate {
  id          Int       @id @default(autoincrement())
  ownerId     String?   @map("owner_id")
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  archivedAt  DateTime? @map("archived_at")

  owner             User?              @relation(fields: [ownerId], references: [userId])
  templateTasks     TemplateTask[]
  cleaningSessions  CleaningSession[]

  @@index([ownerId, id], map: "idx_cleaning_session_templates_owner_id")
}

model TemplateTask {
  id                         Int       @id @default(autoincrement())
  cleaningSessionTemplateId Int       @map("cleaning_session_template_id")
  name                       String
  description                String?
  room                        String?
  requiresCleanerPhoto        Boolean   @default(false) @map("requires_cleaner_photo")
  ownerReferenceImageUrl      String?   @map("owner_reference_image_url")
  archivedAt                  DateTime? @map("archived_at")

  cleaningSessionTemplate CleaningSessionTemplate @relation(fields: [cleaningSessionTemplateId], references: [id])
  cleaningSessionTasks    CleaningSessionTask[]

  @@index([cleaningSessionTemplateId], name: "idx_template_tasks_template_id")
}

// =========================================================
// CLEANING SESSIONS
// =========================================================

model CleaningSession {
  id                         Int      @id @default(autoincrement())
  chaletId                   Int      @map("chalet_id")
  ownerId                    String   @map("owner_id")
  cleanerId                  String?  @map("cleaner_id")
  cleaningSessionTemplateId  Int?     @map("cleaning_session_template_id")

  sessionDate DateTime @db.Date @map("session_date")
  startTime   DateTime @db.Time @map("start_time")
  endTime     DateTime @db.Time @map("end_time")

  assignmentStatus   AssignmentStatus @default(unassigned) @map("assignment_status")
  completionStatus   CompletionStatus @default(upcoming) @map("completion_status")
  paymentStatus      PaymentStatus    @default(pending) @map("payment_status")
  paymentReceivedAt  DateTime?        @map("payment_received_at")

  hourlyRate Decimal  @default(14.00) @db.Decimal(10, 2) @map("hourly_rate")
  totalCost  Decimal? @db.Decimal(10, 2) @map("total_cost")

  cancellationReason String?   @map("cancellation_reason")
  cancelledAt        DateTime? @map("cancelled_at")
  cancelledBy        String?   @map("cancelled_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  chalet                    Chalet                    @relation(fields: [chaletId], references: [id])
  owner                     User                      @relation("SessionOwner", fields: [ownerId], references: [userId])
  cleaner                   User?                     @relation("SessionCleaner", fields: [cleanerId], references: [userId])
  cleaningSessionTemplate   CleaningSessionTemplate?  @relation(fields: [cleaningSessionTemplateId], references: [id])
  cancelledByUser           User?                     @relation("SessionCancelledBy", fields: [cancelledBy], references: [userId])

  cleaningSessionTasks CleaningSessionTask[]

  @@index([chaletId, sessionDate], name: "idx_cleaning_sessions_chalet_date")
  @@index([ownerId, sessionDate], name: "idx_cleaning_sessions_owner_date")
  @@index([cleanerId, sessionDate], name: "idx_cleaning_sessions_cleaner_date")
  @@index([sessionDate], name: "idx_cleaning_sessions_date")
  @@index([assignmentStatus], name: "idx_cleaning_sessions_assignment_status")
  @@index([completionStatus], name: "idx_cleaning_sessions_completion_status")
  @@index([paymentStatus], name: "idx_cleaning_sessions_payment_status")
}

// =========================================================
// CLEANING SESSION TASKS
// Snapshotted from TemplateTask when a session is created.
// =========================================================

model CleaningSessionTask {
  id                       Int       @id @default(autoincrement())
  cleaningSessionId        Int       @map("cleaning_session_id")
  templateTaskId           Int?      @map("template_task_id")
  name                     String
  description              String?
  room                     String?
  requiresCleanerPhoto     Boolean   @default(false) @map("requires_cleaner_photo")
  ownerReferenceImageUrl   String?   @map("owner_reference_image_url")
  status                   CleaningSessionTaskStatus @default(pending)
  completedAt              DateTime? @map("completed_at")
  archivedAt               DateTime? @map("archived_at")

  cleaningSession CleaningSession @relation(fields: [cleaningSessionId], references: [id])
  templateTask    TemplateTask?   @relation(fields: [templateTaskId], references: [id])
  taskImages      TaskImage[]

  @@index([id], name: "idx_cleaning_session_tasks_id")
}

model TaskImage {
  id                     Int      @id @default(autoincrement())
  cleaningSessionTaskId  Int      @map("cleaning_session_task_id")
  storageKey             String   @map("storage_key")
  url                    String?
  uploadedAt             DateTime @default(now()) @map("uploaded_at")

  cleaningSessionTask CleaningSessionTask @relation(fields: [cleaningSessionTaskId], references: [id])
}

// =========================================================
// NOTIFICATIONS
// =========================================================

model Notification {
  id                Int              @id @default(autoincrement())
  userId            String           @map("user_id")
  type              NotificationType
  title             String
  message           String
  relatedEntityType String?          @map("related_entity_type")
  relatedEntityId   Int?             @map("related_entity_id")
  isRead            Boolean          @default(false) @map("is_read")
  createdAt         DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId])
}
