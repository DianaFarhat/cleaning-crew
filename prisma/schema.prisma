// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"

}

// =========================================================
// ENUMS
// =========================================================

enum UserRole {
  cleaner
  owner
  admin
}

enum CleanerStatus {
  active
  inactive
}

enum AssignmentStatus {
  assigned
  unassigned
}

enum CompletionStatus {
  upcoming
  in_progress
  completed
  cancelled
}

enum PaymentStatus {
  pending
  received
}

enum CleaningSessionTaskStatus {
  pending
  completed
  skipped
}

enum NotificationType {
  session_assigned
  session_cancelled
  session_updated
  session_started
  session_completed
  session_unassigned_alert
}

// =========================================================
// USERS & AVAILABILITY
// =========================================================

model User {
  userId              String          @id @default(uuid())
  username            String
  role                UserRole
  email               String          @unique
  email_verified      Boolean         @default(false)
  email_verified_at   DateTime?
  password_hash       String
  password_changed_at DateTime?
  phone_number        String //TODO: This shouldn't be nullable
  profile_image       String?
  cleaner_status      CleanerStatus?
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt

  availability_slots          AvailabilitySlot[]
  chalets                     Chalet[]
  cleaning_session_templates  CleaningSessionTemplate[]
  owned_cleaning_sessions     CleaningSession[] @relation("SessionOwner")
  cleaner_cleaning_sessions   CleaningSession[] @relation("SessionCleaner")
  cancelled_cleaning_sessions CleaningSession[] @relation("SessionCancelledBy")
  notifications               Notification[]

  @@index([role, username], name: "idx_users_role_username")
}

model AvailabilitySlot {
  id         Int      @id @default(autoincrement())
  user_id    String
  date       DateTime @db.Date
  start_time DateTime @db.Time
  end_time   DateTime @db.Time
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cleaner User @relation(fields: [user_id], references: [userId], onDelete: Cascade)

  @@unique([user_id, date, start_time, end_time])
  @@index([user_id, date], map: "idx_availability_user_date")
}

// =========================================================
// CHALETS
// =========================================================

model Chalet {
  id                                    Int      @id @default(autoincrement())
  owner_id                              String
  name                                  String
  location                              String
  latitude                              Decimal? @db.Decimal(10, 8)
  longitude                             Decimal? @db.Decimal(11, 8)
  access_instructions                   String?
  permanent_notes                       String?
  default_cleaning_session_template_id  Int?    // TODO: are we sure it's optional?
  created_at                            DateTime @default(now())
  updated_at                            DateTime @updatedAt

  owner                              User                      @relation(fields: [owner_id], references: [userId])
  default_cleaning_session_template  CleaningSessionTemplate?  @relation(fields: [default_cleaning_session_template_id], references: [id])
  chalet_images                      ChaletImage[]
  cleaning_sessions                  CleaningSession[]

  @@index([owner_id, id], map: "idx_chalets_owner_id")
  @@index([default_cleaning_session_template_id], map: "idx_chalets_default_template")
}

 // TODO: Reached here
model ChaletImage {
  id            Int      @id @default(autoincrement())
  chalet_id     Int
  storage_key   String
  url           String?
  is_cover      Boolean  @default(false)
  display_order Int?
  uploaded_at   DateTime @default(now())

  chalet Chalet @relation(fields: [chalet_id], references: [id])

  @@index([chalet_id], name: "idx_chalet_images_chalet_id")
}

// =========================================================
// CLEANING SESSION TEMPLATES
// Owner-level, reusable checklists. A chalet can point to one
// as its default; individual sessions can still override.
// =========================================================

model CleaningSessionTemplate {
  id          Int      @id @default(autoincrement())
  owner_id    String?
  name        String
  description String?
  created_at  DateTime @default(now())

  owner             User?              @relation(fields: [owner_id], references: [userId])
  template_tasks    TemplateTask[]
  chalets           Chalet[]
  cleaning_sessions CleaningSession[]
}

model TemplateTask {
  id                            Int       @id @default(autoincrement())
  cleaning_session_template_id Int
  name                          String
  description                   String?
  room                          String?
  requires_cleaner_photo        Boolean   @default(false)
  owner_reference_image_url     String?
  archived_at                   DateTime?

  cleaning_session_template CleaningSessionTemplate @relation(fields: [cleaning_session_template_id], references: [id])
  cleaning_session_tasks    CleaningSessionTask[]

  @@index([cleaning_session_template_id], name: "idx_template_tasks_template_id")
}

// =========================================================
// CLEANING SESSIONS
// =========================================================

model CleaningSession {
  id                            Int      @id @default(autoincrement())
  chalet_id                     Int
  owner_id                      String
  cleaner_id                    String?
  cleaning_session_template_id  Int?

  session_date DateTime @db.Date
  start_time   DateTime @db.Time
  end_time     DateTime @db.Time

  assignment_status    AssignmentStatus @default(unassigned)
  completion_status    CompletionStatus @default(upcoming)
  payment_status       PaymentStatus    @default(pending)
  payment_received_at  DateTime?

  hourly_rate Decimal  @default(14.00) @db.Decimal(10, 2)
  total_cost  Decimal? @db.Decimal(10, 2)

  cancellation_reason String?
  cancelled_at        DateTime?
  cancelled_by         String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  chalet                     Chalet                    @relation(fields: [chalet_id], references: [id])
  owner                      User                      @relation("SessionOwner", fields: [owner_id], references: [userId])
  cleaner                    User?                     @relation("SessionCleaner", fields: [cleaner_id], references: [userId])
  cleaning_session_template  CleaningSessionTemplate?  @relation(fields: [cleaning_session_template_id], references: [id])
  cancelled_by_user          User?                     @relation("SessionCancelledBy", fields: [cancelled_by], references: [userId])

  cleaning_session_tasks CleaningSessionTask[]

  @@index([chalet_id, session_date], name: "idx_cleaning_sessions_chalet_date")
  @@index([owner_id, session_date], name: "idx_cleaning_sessions_owner_date")
  @@index([cleaner_id, session_date], name: "idx_cleaning_sessions_cleaner_date")
  @@index([session_date], name: "idx_cleaning_sessions_date")
  @@index([assignment_status], name: "idx_cleaning_sessions_assignment_status")
  @@index([completion_status], name: "idx_cleaning_sessions_completion_status")
  @@index([payment_status], name: "idx_cleaning_sessions_payment_status")
}

// =========================================================
// CLEANING SESSION TASKS
// Snapshotted from TemplateTask (via the chalet's default
// template, or an override) when a session is created.
// =========================================================

model CleaningSessionTask {
  id                          Int       @id @default(autoincrement())
  cleaning_session_id         Int
  template_task_id            Int?
  name                        String
  description                 String?
  room                        String?
  requires_cleaner_photo      Boolean   @default(false)
  owner_reference_image_url   String?
  status                      CleaningSessionTaskStatus @default(pending)
  completed_at                DateTime?
  archived_at                 DateTime?

  cleaning_session CleaningSession @relation(fields: [cleaning_session_id], references: [id])
  template_task    TemplateTask?   @relation(fields: [template_task_id], references: [id])
  task_images      TaskImage[]

  @@index([id], name: "idx_cleaning_session_tasks_id")
}

model TaskImage {
  id                        Int      @id @default(autoincrement())
  cleaning_session_task_id  Int
  storage_key               String
  url                       String?
  uploaded_at                DateTime @default(now())

  cleaning_session_task CleaningSessionTask @relation(fields: [cleaning_session_task_id], references: [id])
}

// =========================================================
// NOTIFICATIONS
// =========================================================

model Notification {
  id                   Int              @id @default(autoincrement())
  user_id              String
  type                 NotificationType
  title                String
  message              String
  related_entity_type  String?
  related_entity_id    Int?
  is_read              Boolean          @default(false)
  created_at           DateTime         @default(now())

  user User @relation(fields: [user_id], references: [userId])
}